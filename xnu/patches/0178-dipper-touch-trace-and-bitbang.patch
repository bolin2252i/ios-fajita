 /* ------------------------------------------------------------------ dipper */
 
+/* ------------------------------------------------------- dipper bit-bang */
+/*
+ * The SE hands over with FIFO_IF_DISABLE set and its 0x2000 block refusing AHB
+ * access, so sweetts=3 drives SDA/SCL as open-drain GPIOs instead. The internal
+ * pull-up is the only bias, transfers run at about 100 kHz, and SCL held low
+ * between bits is legal I2C, so a preemption cannot corrupt a byte.
+ */
+#define BB_SDA  DP_GPIO_SDA
+#define BB_SCL  DP_GPIO_SCL
+#define BB_US   5u
+
+/* Pull the line down by enabling the output driver at 0; release it by turning
+ * the driver off and letting the pull-up raise the line. Never drive high. */
+static void
+bb_pull_low(unsigned pin)
+{
+	touch_wr(st.gpio, TOUCH_GPIO_IO(pin),
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & ~2u);
+	touch_wr(st.gpio, TOUCH_GPIO_CFG(pin),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(pin)) | 0x200u);
+}
+
+static void
+bb_release(unsigned pin)
+{
+	touch_wr(st.gpio, TOUCH_GPIO_CFG(pin),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(pin)) & ~0x200u);
+}
+
+static bool
+bb_sense(unsigned pin)
+{
+	return (touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & 1u) != 0;
+}
+
+static void
+bb_start(void)
+{
+	bb_release(BB_SDA);
+	bb_release(BB_SCL);
+	delay(BB_US);
+	bb_pull_low(BB_SDA);
+	delay(BB_US);
+	bb_pull_low(BB_SCL);
+	delay(BB_US);
+}
+
+static void
+bb_stop(void)
+{
+	bb_pull_low(BB_SDA);
+	delay(BB_US);
+	bb_release(BB_SCL);
+	delay(BB_US);
+	bb_release(BB_SDA);
+	delay(BB_US);
+}
+
+static bool
+bb_tx_byte(uint8_t b)
+{
+	bool ack;
+
+	for (int i = 7; i >= 0; --i) {
+		if (b & (1u << i)) {
+			bb_release(BB_SDA);
+		} else {
+			bb_pull_low(BB_SDA);
+		}
+		delay(BB_US);
+		bb_release(BB_SCL);
+		delay(BB_US);
+		bb_pull_low(BB_SCL);
+		delay(BB_US);
+	}
+	bb_release(BB_SDA);            /* ACK slot: the IC may pull SDA low */
+	delay(BB_US);
+	bb_release(BB_SCL);
+	delay(BB_US);
+	ack = !bb_sense(BB_SDA);
+	bb_pull_low(BB_SCL);
+	delay(BB_US);
+	return ack;
+}
+
+static uint8_t
+bb_rx_byte(bool ack)
+{
+	uint8_t v = 0;
+
+	bb_release(BB_SDA);
+	for (unsigned i = 0; i < 8; ++i) {
+		delay(BB_US);
+		bb_release(BB_SCL);
+		delay(BB_US);
+		v = (uint8_t)((v << 1) | (bb_sense(BB_SDA) ? 1u : 0u));
+		bb_pull_low(BB_SCL);
+	}
+	if (ack) {
+		bb_pull_low(BB_SDA);
+	} else {
+		bb_release(BB_SDA);
+	}
+	delay(BB_US);
+	bb_release(BB_SCL);
+	delay(BB_US);
+	bb_pull_low(BB_SCL);
+	delay(BB_US);
+	bb_release(BB_SDA);
+	return v;
+}
+
+/* One address phase plus payload; a read continues on a repeated START. */
+static int
+bb_xfer(const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr)
+{
+	bool acked;
+
+	bb_start();
+	acked = bb_tx_byte((uint8_t)(DP_TS_ADDR << 1));
+	for (unsigned i = 0; acked && i < nt; ++i) {
+		acked = bb_tx_byte(tx[i]);
+	}
+	if (acked && nr) {
+		bb_start();
+		acked = bb_tx_byte((uint8_t)((DP_TS_ADDR << 1) | 1u));
+		for (unsigned i = 0; acked && i < nr; ++i) {
+			rx[i] = bb_rx_byte(i + 1u < nr);
+		}
+	}
+	bb_stop();
+	return acked ? 0 : ENXIO;
+}
